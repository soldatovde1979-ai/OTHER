// Шаблон настроек VS Code для расширения zoo-code (ключи zoo-code.*).
// Куда класть: <проект>/.vscode/settings.json (JSONC — комментарии допустимы).
// Ключи ниже взяты из package.json zoo-code 3.82.1 (часть настроек живёт только в UI —
// проверять актуальные имена в Settings → Zoo Code).

{
  // Разрешённые/запрещённые команды терминала (пример):
  "zoo-code.allowedCommands": [
    "npm test",
    "git status",
    "git diff",
    "git log --oneline -20"
  ],
  "zoo-code.deniedCommands": [
    "git push",
    "rm -rf",
    "DROP"
  ],

  // Таймауты (секунды):
  // "zoo-code.commandExecutionTimeout": 60,
  // "zoo-code.apiRequestTimeout": 120,
  // "zoo-code.commandTimeoutAllowlist": ["npm run build"],

  // Правила агентов и todo-дисциплина:
  "zoo-code.useAgentRules": true,
  // "zoo-code.newTaskRequireTodos": true,
  // "zoo-code.preventCompletionWithOpenTodos": true,

  // Контекстные действия и поиск:
  // "zoo-code.enableCodeActions": true,
  // "zoo-code.maximumIndexedFilesForFileSearch": 1000,

  // Отладка расширения (обычно не включать):
  // "zoo-code.debug": false
  // "zoo-code.debugProxy.enabled": false

  // Прочие подтверждённые ключи из package.json 3.82.1:
  // zoo-code.acceptInput, zoo-code.addToContext, zoo-code.autoImportSettingsPath,
  // zoo-code.customStoragePath, zoo-code.contextMenu, zoo-code.importSettings,
  // zoo-code.terminalAddToContext, zoo-code.terminalExplainCommand, zoo-code.terminalFixCommand,
  // zoo-code.workspace.rootResolution, zoo-code.showRipgrepDiagnostic
}
