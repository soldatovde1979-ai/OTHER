# Шаблон ENV-переменных для MCP-серверов и агентов. Скопировать в место, где они
# доступны процессу (или задать в окружении терминала/пользователя), в git НЕ коммитить.
# Все значения — плейсхолдеры, реальные секреты сюда не вписывать.

# Токен для MCP-сервера GitHub
GITHUB_TOKEN=PLACEHOLDER_GITHUB_TOKEN

# Токен для удалённого MCP (Confluence и т.п.)
CONFLUENCE_TOKEN=PLACEHOLDER_CONFLUENCE_TOKEN

# Универсальный пример для stdio-серверов с ключом
MY_MCP_TOKEN=PLACEHOLDER_MY_MCP_TOKEN
