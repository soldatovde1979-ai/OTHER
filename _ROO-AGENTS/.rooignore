# Шаблон .rooignore (кладётся в КОРЕНЬ проекта).
# Синтаксис как у .gitignore; работает НЕЗАВИСИМО от .gitignore: совпавшие файлы
# ИИ не читает, не ищет и не правит. Поддержка !-негации зависит от версии — проверять.
# Для активации: скопировать в <проект>/.rooignore и адаптировать пути.

# Данные и результаты — вне контекста ИИ (каркас в git, содержимое — нет):
data/
result/

# Секреты и окружение:
.env
*.env
*.env.*
secrets/
*.pem
*.key

# Служебные и личные настройки:
.vscode/           # раскомментируйте, если личные настройки не должны попадать в контекст
*.code-workspace

# Бэкапы и временные файлы:
*.bak
*.bak_*
~$*
*.tmp

# Тяжёлые бинарники и собранные артефакты (если не нужны ИИ):
build/
*.exe
*.dll
*.zip

# Зависимости и кэши:
node_modules/
__pycache__/
