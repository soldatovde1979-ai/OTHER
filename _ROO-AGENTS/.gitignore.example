# Шаблон записей для .gitignore проекта: что из настройки агентов (.roo) коммитить,
# а что — нет. Скопировать блок в <проект>/.gitignore. Комментарии (#) — нативные.

# --- Настройка агентов Roo (.roo) ---
# В git (текст, часть стандарта проекта):
# .roo/rules*/          — правила всех режимов
# .roo/commands/        — slash-команды
# .roo/skills/          — skills
# .roo/mcp.json         — MCP проекта (если в нём нет секретов; иначе игнорить!)
# .roomodes             — кастомные режимы
# .rooignore            — игнор-файл ИИ
# Вне git:
# .roo/local*           — личные локальные переопределения (если заведёте)
# .roo/mcp.json         — если хранит секреты (тогда ENV-вариант в git не класть)
# .roo/**/*.bak         — бэкапы

# Раскомментируйте по политике проекта:
# .roo/mcp.json
# .roomodes
# .rooignore
