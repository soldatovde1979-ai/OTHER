// Шаблон проектного MCP-конфига. Для активации: скопировать в <проект>/.roo/mcp.json
// и УДАЛИТЬ все //-комментарии (строгий JSON комментарии не допускает; поэтому здесь .jsonc).
// Секреты — только через env (переменные окружения или ${VAR}), не вписывать в файл.

{
  // Список MCP-серверов. Каждый сервер — объект с полями ниже.
  "mcpServers": {

    // Пример 1: локальный stdio-сервер (npm-пакет или python-скрипт):
    // "my-filesystem": {
    //   "command": "npx",                                  // исполняемый файл
    //   "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:/data/readonly"],
    //   "env": { "API_KEY": "${MY_MCP_TOKEN}" },           // секреты — только так
    //   "cwd": "C:/work",
    //   "alwaysAllow": ["read_file"],                     // автодопуск к инструментам
    //   "disabled": false,
    //   "timeout": 60
    // },

    // Пример 2: удалённый HTTP-сервер:
    // "remote-docs": {
    //   "type": "streamable-http",                        // альтернатива: "sse"
    //   "url": "https://mcp.example.com/mcp",
    //   "headers": { "Authorization": "Bearer ${MCP_TOKEN}" },
    //   "disabled": true                                  // отключён по умолчанию
    // }
  }
}
